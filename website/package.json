{
  "name": "tg2cloud-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TG2Cloud Chinese documentation, dependency-free static site",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
